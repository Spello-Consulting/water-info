# Water-info production environment variables
APP_ENV=production

# Set the config file to use
APP_CONFIG=configs/myconfig.yaml

# Copy to .env and fill in. scripts/launch.sh loads this into the environment.
# .env is git-ignored — never commit real secrets.

# SMTP (used by SCLogging for email alerts)
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password

# Twilio (used by src/sms.py for SMS alerts). If unset, SMS is skipped with a
# warning and email alerts still function.
#
# TWILIO_ACCOUNT_SID is always your ACCOUNT SID (starts with "AC"), from the
# Twilio Console dashboard. Then choose ONE auth style:
#
#   A) Account SID + Auth Token:
#        TWILIO_AUTH_TOKEN=your-account-auth-token
#   B) API Key (recommended): leave AUTH_TOKEN unset and set:
#        TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#        TWILIO_API_KEY_SECRET=your-api-key-secret
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
#TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_API_KEY_SECRET=your-api-key-secret
# E.164 number (+15005550006) or an alphanumeric sender ID (<= 11 chars).
TWILIO_FROM_NUMBER=+15005550006
