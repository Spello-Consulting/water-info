# Water-info development environment variables
APP_ENV=development

# Set the config file to use
APP_CONFIG=configs/development.yaml

# STMP credentials
SMTP_USERNAME=op://Dev/Gmail SMTP/username
SMTP_PASSWORD="op://Dev/Gmail SMTP/password"

# Twilio for SMS (API Key auth)
# TWILIO_ACCOUNT_SID must be your ACCOUNT SID (starts with "AC"), found on the
# Twilio Console dashboard — NOT the API key SID. Paste it below.
TWILIO_ACCOUNT_SID=op://Dev/Twillo/AccountSID
TWILIO_API_KEY_SID=op://Dev/Twillo/APIKeySID
TWILIO_API_KEY_SECRET=op://Dev/Twillo/APIKeySecret

# Alphanumeric sender IDs must be <= 11 chars (letters/digits/spaces).
TWILIO_FROM_NUMBER=SpelloWater

# Numberic receipient IDs - must be valid IDD format numbers. If specified, this overrides
# the SMS.SendSMSTo key in the configuration file.
TWILIO_SEND_SMS_TO=op://Dev/SMSAlertNumbers/Italy